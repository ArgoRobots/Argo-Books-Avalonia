<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:colorPrimitives="clr-namespace:Avalonia.Controls.Primitives;assembly=Avalonia.Controls.ColorPicker"
             xmlns:loc="using:ArgoBooks.Localization"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="32"
             x:Class="ArgoBooks.Controls.ColorPickerInput"
             x:Name="Root">

    <Grid ColumnDefinitions="Auto,*">
        <!-- Color Swatch Button -->
        <Button Grid.Column="0"
                Width="32" Height="32"
                Padding="4"
                Margin="0,0,8,0"
                CornerRadius="4"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}"
                Command="{Binding #Root.TogglePickerCommand}">
            <Border Width="20" Height="20"
                    CornerRadius="2"
                    Background="{Binding #Root.ColorBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}" />
        </Button>

        <!-- Hex Input -->
        <TextBox Grid.Column="1"
                 Text="{Binding #Root.ColorValue, Mode=TwoWay}"
                 PlaceholderText="#000000"
                 VerticalAlignment="Center"
                 Padding="8,6"
                 MaxLength="9" />

        <!-- Color Picker Popup -->
        <Popup Grid.Column="0"
               IsOpen="{Binding #Root.IsPickerOpen, Mode=TwoWay}"
               Placement="Bottom"
               PlacementTarget="{Binding #Root}"
               IsLightDismissEnabled="True">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    BoxShadow="0 4 16 0 #22000000">
                <StackPanel Spacing="12">
                    <!-- Saturation/value spectrum with hue slider (Avalonia first-party color picker) -->
                    <colorPrimitives:ColorSpectrum x:Name="ColorPickerControl"
                                                   Width="220" Height="150"
                                                   CornerRadius="4"
                                                   Shape="Box"
                                                   Components="SaturationValue"
                                                   ColorChanged="OnColorPickerColorChanged" />
                    <colorPrimitives:ColorSlider Width="220"
                                                 ColorModel="Hsva"
                                                 ColorComponent="Component1"
                                                 IsRoundingEnabled="True"
                                                 HsvColor="{Binding #ColorPickerControl.HsvColor, Mode=TwoWay}" />

                    <!-- Preview and Hex Input Row -->
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="4"
                                Background="{Binding #Root.ColorBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding #Root.ColorValue, Mode=TwoWay}"
                                 VerticalAlignment="Center"
                                 Margin="8,0,0,0"
                                 FontFamily="Consolas,Menlo,monospace"
                                 FontSize="13"
                                 Padding="6,4"
                                 MaxLength="9" />
                    </Grid>

                    <!-- Action Buttons Row -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="{loc:Loc Cancel}"
                                Classes="secondary"
                                MinWidth="70"
                                Command="{Binding #Root.CancelColorCommand}" />
                        <Button Content="{loc:Loc Apply}"
                                Classes="primary"
                                MinWidth="70"
                                Command="{Binding #Root.ApplyColorCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
