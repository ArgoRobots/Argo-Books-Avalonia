<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:loc="using:ArgoBooks.Localization"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="ArgoBooks.Modals.CurrencyLoadingModal"
             x:CompileBindings="False">

    <controls:ModalOverlay IsOpen="{Binding ShowCurrencyLoading}"
                           CloseOnBackdropClick="False"
                           CloseOnEscape="False">
        <controls:ModalOverlay.ModalContent>
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="400"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="12"
                    BoxShadow="0 8 32 0 #40000000">
                <controls:LoadingState Margin="24"
                                       IsActive="{Binding IsSavingCurrency}"
                                       Message="{loc:Loc 'Fetching Exchange Rates...'}"
                                       Detail="{loc:Loc 'Please wait while we connect to the exchange rate service.'}"
                                       ShowProgress="True"
                                       Percent="{Binding CurrencyLoadingProgress}"
                                       IsCancellable="True"
                                       CancelCommand="{Binding CancelCurrencyLoadingCommand}" />
            </Border>
        </controls:ModalOverlay.ModalContent>
    </controls:ModalOverlay>
</UserControl>
