<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.Mobile.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="700"
             x:Class="ArgoBooks.Mobile.Views.CompanySwitcherView"
             x:DataType="vm:CompanySwitcherViewModel">

  <Grid RowDefinitions="*,Auto" Margin="16">
    <ScrollViewer Grid.Row="0">
      <ItemsControl ItemsSource="{Binding Companies}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CompanyRowViewModel">
            <Button Command="{Binding SelectCommand}"
                    HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                    Background="Transparent" Padding="8,12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding CompanyLabel}" FontSize="15" />
                <TextBlock Grid.Column="1" Text="Active" FontSize="12" Opacity="0.7"
                           VerticalAlignment="Center"
                           IsVisible="{Binding IsActive}" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Button Grid.Row="1"
            Content="Pair another company"
            Command="{Binding PairAnotherCommand}"
            IsEnabled="{Binding !IsBusy}"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            Margin="0,10,0,0" />
  </Grid>
</UserControl>
