<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Offline support tool for recovering a company file whose password has been lost.

        Deliberately NOT part of ArgoBooks.sln: it must never be built into or shipped with
        the app. Build it on demand with:
            dotnet build tools/ArgoBooks.Recovery
        then run the produced argo-recovery executable directly.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>ArgoBooks.Recovery</RootNamespace>
        <AssemblyName>argo-recovery</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\ArgoBooks.Core\ArgoBooks.Core.csproj" />
    </ItemGroup>

</Project>
