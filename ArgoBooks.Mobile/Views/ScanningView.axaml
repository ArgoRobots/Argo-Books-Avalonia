<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.Mobile.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="700"
             x:Class="ArgoBooks.Mobile.Views.ScanningView"
             x:DataType="vm:ScanningViewModel">

  <Grid Margin="24">

    <StackPanel Spacing="14" VerticalAlignment="Center" IsVisible="{Binding !IsFailed}">
      <TextBlock Text="Scanning your receipt" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />

      <TextBlock Text="Reading the receipt" FontSize="14" Opacity="0.85" Margin="0,10,0,0" />
      <TextBlock Text="Auto-suggesting products &amp; supplier" FontSize="14" Opacity="0.85" />
      <TextBlock Text="Checking the totals" FontSize="14" Opacity="0.85" />

      <TextBlock Text="The edges, crop, and straighten already happened live in the camera. This step reads it with AI."
                 Opacity="0.6" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"
                 HorizontalAlignment="Center" Margin="0,12,0,0" />
    </StackPanel>

    <StackPanel Spacing="16" VerticalAlignment="Center" IsVisible="{Binding IsFailed}">
      <TextBlock Text="Couldn't read that receipt" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
      <TextBlock Text="{Binding ErrorMessage}"
                 Opacity="0.75" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"
                 HorizontalAlignment="Center"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
      <Button Content="Try again"
              Command="{Binding RetryCommand}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Margin="0,10,0,0" />
    </StackPanel>

  </Grid>
</UserControl>
