<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:loc="using:ArgoBooks.Localization"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="200"
             x:Class="ArgoBooks.Controls.LoadingState"
             x:DataType="controls:LoadingState">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                Margin="24">

        <!-- Spinner -->
        <controls:LoadingSpinner SizePreset="{Binding SpinnerPreset, RelativeSource={RelativeSource AncestorType=controls:LoadingState}}"
                                 IsSpinning="{Binding IsActive, RelativeSource={RelativeSource AncestorType=controls:LoadingState}}"
                                 HorizontalAlignment="Center" />

        <!-- Primary message -->
        <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType=controls:LoadingState}}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center" />

        <!-- Progress bar + percent (determinate mode) -->
        <StackPanel Spacing="8"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding ShowProgress, RelativeSource={RelativeSource AncestorType=controls:LoadingState}}">
            <ProgressBar Minimum="0" Maximum="100"
                         Value="{Binding Percent, RelativeSource={RelativeSource AncestorType=controls:LoadingState}}"
                         IsIndeterminate="{Binding IsIndeterminate, RelativeSource={RelativeSource AncestorType=controls:LoadingState}}"
                         Height="6"
                         CornerRadius="3"
                         Width="280"
                         HorizontalAlignment="Center"
                         Foreground="{DynamicResource PrimaryBrush}" />
            <TextBlock Text="{Binding Percent, StringFormat='{}{0:0}%', RelativeSource={RelativeSource AncestorType=controls:LoadingState}}"
                       IsVisible="{Binding !IsIndeterminate, RelativeSource={RelativeSource AncestorType=controls:LoadingState}}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Optional detail line -->
        <TextBlock Text="{Binding Detail, RelativeSource={RelativeSource AncestorType=controls:LoadingState}}"
                   IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}, RelativeSource={RelativeSource AncestorType=controls:LoadingState}}"
                   FontSize="13"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center" />

        <!-- Optional cancel -->
        <Button Classes="secondary-button"
                Content="{loc:Loc Cancel}"
                IsVisible="{Binding IsCancellable, RelativeSource={RelativeSource AncestorType=controls:LoadingState}}"
                Command="{Binding CancelCommand, RelativeSource={RelativeSource AncestorType=controls:LoadingState}}"
                HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
