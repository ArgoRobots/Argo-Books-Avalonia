<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.Mobile.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="700"
             x:Class="ArgoBooks.Mobile.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

  <UserControl.Styles>
    <Style Selector="Border.stat-card">
      <Setter Property="Background" Value="#14808080" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="14,4,14,16" Spacing="14">

      <!-- Stat cards -->
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" >
        <Border Grid.Row="0" Grid.Column="0" Classes="stat-card" Margin="0,0,5,5">
          <StackPanel>
            <TextBlock Text="{Binding MoneyIn}" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="Money in" FontSize="11" Opacity="0.65" />
          </StackPanel>
        </Border>
        <Border Grid.Row="0" Grid.Column="1" Classes="stat-card" Margin="5,0,0,5">
          <StackPanel>
            <TextBlock Text="{Binding MoneyOut}" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="Money out" FontSize="11" Opacity="0.65" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="0" Classes="stat-card" Margin="0,0,5,0">
          <StackPanel>
            <TextBlock Text="{Binding Profit}" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="Profit" FontSize="11" Opacity="0.65" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Classes="stat-card" Margin="5,0,0,0">
          <StackPanel>
            <TextBlock Text="{Binding ProfitMargin}" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="Profit margin" FontSize="11" Opacity="0.65" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Cash flow chart -->
      <StackPanel IsVisible="{Binding HasCashFlowChart}" Spacing="6">
        <TextBlock Text="Cash flow" FontSize="13" FontWeight="SemiBold" />
        <lvc:CartesianChart Height="150"
                             Series="{Binding CashFlowSeries}"
                             XAxes="{Binding CashFlowXAxes}" />
      </StackPanel>
      <TextBlock Text="Not enough dated activity yet to chart cash flow."
                 IsVisible="{Binding !HasCashFlowChart}"
                 Opacity="0.6" FontSize="12" TextWrapping="Wrap" />

      <!-- Who owes you -->
      <StackPanel Spacing="4">
        <TextBlock Text="Who owes you" FontSize="13" FontWeight="SemiBold" />
        <TextBlock Text="Nobody owes you right now." Opacity="0.6" FontSize="12"
                   IsVisible="{Binding !HasWhoOwesYou}" />
        <ItemsControl ItemsSource="{Binding WhoOwesYou}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RowItemViewModel">
              <Button Command="{Binding OpenCommand}" HorizontalContentAlignment="Stretch"
                      HorizontalAlignment="Stretch" Background="Transparent" Padding="4,7">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" FontSize="14" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.6" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Amount}" FontWeight="Bold" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Recent revenue -->
      <StackPanel Spacing="4">
        <TextBlock Text="Recent revenue" FontSize="13" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding RecentRevenue}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RowItemViewModel">
              <Button Command="{Binding OpenCommand}" HorizontalContentAlignment="Stretch"
                      HorizontalAlignment="Stretch" Background="Transparent" Padding="4,7">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" FontSize="14" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.6" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Amount}" FontWeight="Bold" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Recent expenses -->
      <StackPanel Spacing="4">
        <TextBlock Text="Recent expenses" FontSize="13" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding RecentExpenses}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RowItemViewModel">
              <Button Command="{Binding OpenCommand}" HorizontalContentAlignment="Stretch"
                      HorizontalAlignment="Stretch" Background="Transparent" Padding="4,7">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" FontSize="14" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.6" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Amount}" FontWeight="Bold" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
