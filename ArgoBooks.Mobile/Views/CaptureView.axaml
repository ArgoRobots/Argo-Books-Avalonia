<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.Mobile.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="700"
             x:Class="ArgoBooks.Mobile.Views.CaptureView"
             x:DataType="vm:CaptureViewModel">

  <UserControl.Styles>
    <Style Selector="Border.company-chip">
      <Setter Property="Background" Value="#14808080" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border.viewfinder">
      <Setter Property="BorderBrush" Value="#2FB8A8" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Border.confirmation-toast">
      <Setter Property="Background" Value="#1F8F83" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.recent-scan-row">
      <Setter Property="Background" Value="#14808080" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <ScrollViewer>
      <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">

        <Border Grid.Row="0" Classes="company-chip" Margin="0,0,0,10">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0" Text="Scanning into" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding ActiveCompanyLabel}"
                       FontSize="12" FontWeight="SemiBold"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <TextBlock Grid.Row="1"
                   Text="{Binding ScansUsedThisMonth, StringFormat='{}{0} scans used this month'}"
                   FontSize="12" Opacity="0.6" Margin="2,0,0,10" />

        <Border Grid.Row="2" Classes="viewfinder" MinHeight="240">
          <TextBlock Text="Line up the receipt in frame, then tap Scan receipt"
                     Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28" />
        </Border>

        <Button Grid.Row="3"
                Content="Scan receipt"
                Command="{Binding ScanCommand}"
                IsEnabled="{Binding !IsBusy}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Margin="0,14,0,0" />

        <Button Grid.Row="4"
                Content="Import from photos"
                Command="{Binding ScanCommand}"
                IsEnabled="{Binding !IsBusy}"
                Background="Transparent"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Margin="0,8,0,0" />

        <TextBlock Grid.Row="5"
                   Text="Detects, crops &amp; straightens automatically."
                   Opacity="0.5" FontSize="11" TextAlignment="Center"
                   HorizontalAlignment="Center" Margin="0,10,0,0" />

        <!-- Recent scans -->
        <StackPanel Grid.Row="6" Spacing="6" Margin="0,18,0,0" IsVisible="{Binding HasRecentScans}">
          <TextBlock Text="Recent scans" FontSize="13" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding RecentScans}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RecentScanViewModel">
                <Border Classes="recent-scan-row" Margin="0,0,0,6">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{Binding VendorText}" FontSize="14" />
                      <TextBlock Text="{Binding TimeText}" FontSize="11" Opacity="0.6" />
                      <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.75" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding AmountText}" FontWeight="Bold" VerticalAlignment="Top" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- Confirmation toast -->
    <Border Classes="confirmation-toast" IsVisible="{Binding IsConfirmationVisible}"
            VerticalAlignment="Top" HorizontalAlignment="Stretch"
            Margin="16,10,16,0">
      <TextBlock Text="{Binding ConfirmationMessage}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" />
    </Border>
  </Panel>
</UserControl>
