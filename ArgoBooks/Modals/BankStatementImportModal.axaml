<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.ViewModels"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:loc="using:ArgoBooks.Localization"
             xmlns:local="using:ArgoBooks"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="700"
             x:Class="ArgoBooks.Modals.BankStatementImportModal"
             x:DataType="vm:BankStatementImportModalViewModel">

    <UserControl.Styles>
        <!-- Expense / Revenue type toggle buttons (mirrors BankMatchingPage type-toggle-button style) -->
        <Style Selector="Button.type-toggle-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.type-toggle-button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.type-toggle-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.type-toggle-button.selected">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.type-toggle-button.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        </Style>
        <Style Selector="Button.type-toggle-button.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        </Style>

        <!-- Read-only category chip (existing product) -->
        <Style Selector="Border.category-chip">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Clickable category chip (new product) -->
        <Style Selector="Button.category-chip-button">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.category-chip-button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.category-chip-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>

        <!-- Modal width: full while reviewing, compact while the loading spinner shows -->
        <Style Selector="Border.import-modal">
            <Setter Property="MaxWidth" Value="960" />
        </Style>
        <Style Selector="Border.import-modal.loading">
            <Setter Property="MaxWidth" Value="440" />
        </Style>
    </UserControl.Styles>

    <controls:ModalOverlay IsOpen="{Binding IsOpen}"
                           ClosingCommand="{Binding CancelCommand}">
        <controls:ModalOverlay.ModalContent>
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Classes="import-modal"
                    Classes.loading="{Binding IsLoading}"
                    MaxHeight="700"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Margin="24">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Header -->
                    <Border Grid.Row="0" Padding="24,20"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc 'Import bank statement'}"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding FileName}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding FileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="icon-button"
                                    VerticalAlignment="Top"
                                    Command="{Binding CancelCommand}">
                                <PathIcon Data="{x:Static local:Icons.Close}" Width="20" Height="20" />
                            </Button>
                        </Grid>
                    </Border>

                    <Panel Grid.Row="1">
                        <!-- Loading state (while parsing + AI categorization run) -->
                        <StackPanel IsVisible="{Binding IsLoading}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="16" Margin="24,40">
                            <controls:LoadingSpinner SizePreset="Large" />
                            <TextBlock Text="{loc:Loc 'Categorizing your statement...'}"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Row list -->
                        <ScrollViewer IsVisible="{Binding !IsLoading}"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <Grid Margin="24,16,24,30" RowDefinitions="Auto,*">

                            <!-- Column header labels — same column layout as data rows.
                                 Trailing 16px column is a gutter so the row scrollbar doesn't overlap the Supplier/Customer box. -->
                            <Grid Grid.Row="0" ColumnDefinitions="28,90,260,110,150,250,16" Margin="0,0,0,6">
                                <TextBlock Grid.Column="1"
                                           Text="{loc:Loc Date}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Margin="8,0,0,0"
                                           Text="{loc:Loc 'Product'}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Margin="8,0,0,0"
                                           Text="{loc:Loc Amount}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="4" Margin="8,0,0,0"
                                           Text="{loc:Loc Type}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="5" Margin="8,0,0,0"
                                           Text="{loc:Loc 'Supplier / Customer'}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:ImportLineRow">
                                        <Border Padding="0,4"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1">
                                            <!-- Same column layout as the header row above (trailing 16px = scrollbar gutter) -->
                                            <Grid ColumnDefinitions="28,90,260,110,150,250,16">

                                                <!-- Include checkbox -->
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                                          VerticalAlignment="Center" />

                                                <!-- Date — compact read-only formatted text -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DateFormatted}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" />

                                                <!-- Product (carries the category) + read-only category chip + original bank text -->
                                                <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Spacing="2">
                                                    <controls:SearchableDropdown
                                                        Classes="compact"
                                                        Placeholder="{loc:Loc 'Product...'}"
                                                        ItemsSource="{Binding $parent[ItemsControl].((vm:BankStatementImportModalViewModel)DataContext).AvailableProducts}"
                                                        SelectedItem="{Binding ResolvedProductObject, Mode=TwoWay}"
                                                        SearchText="{Binding ProductSearchText, Mode=TwoWay}"
                                                        DisplayMemberPath="Name"
                                                        ShowAddNew="True"
                                                        AddNewText="{loc:Loc 'Create one'}"
                                                        AddNewCommand="{Binding CreateNewProductCommand}"
                                                        HasError="{Binding HasProductError}"
                                                        ErrorMessage="{loc:Loc 'Please select or create a product.'}" />

                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <!-- New product: clickable category chip (opens create-product to set its category) -->
                                                        <Button IsVisible="{Binding IsNewProduct}"
                                                                Classes="category-chip-button"
                                                                Command="{Binding CreateNewProductCommand}"
                                                                ToolTip.Tip="{loc:Loc 'New product. Click to set its category.'}">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="{loc:Loc 'New'}" FontSize="10" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding CategoryDisplay}" FontSize="11"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <!-- Existing product: read-only category chip -->
                                                        <Border Classes="category-chip">
                                                            <Border.IsVisible>
                                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                    <Binding Path="!IsNewProduct" />
                                                                    <Binding Path="CategoryDisplay" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                                                </MultiBinding>
                                                            </Border.IsVisible>
                                                            <TextBlock Text="{Binding CategoryDisplay}" FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </Border>
                                                        <!-- Original bank statement text -->
                                                        <TextBlock Text="{Binding RawDescription}" FontSize="11"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Amount — narrow, no spinner buttons -->
                                                <NumericUpDown Grid.Column="3" Margin="8,0,0,0"
                                                               Value="{Binding Amount, Mode=TwoWay}"
                                                               FormatString="F2"
                                                               ShowButtonSpinner="False"
                                                               HorizontalAlignment="Stretch"
                                                               VerticalAlignment="Center" />

                                                <!-- Expense / Revenue toggle -->
                                                <Border Grid.Column="4" Margin="8,0,0,0"
                                                        Background="{DynamicResource SurfaceAltBrush}"
                                                        CornerRadius="6" Padding="4"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                                        <Button Content="{loc:Loc Expense}"
                                                                Command="{Binding SetExpenseCommand}"
                                                                Classes="type-toggle-button"
                                                                Classes.selected="{Binding !CreateAsRevenue}"
                                                                ToolTip.Tip="{loc:Loc 'Create as expense'}" />
                                                        <Button Content="{loc:Loc Revenue}"
                                                                Command="{Binding SetRevenueCommand}"
                                                                Classes="type-toggle-button"
                                                                Classes.selected="{Binding CreateAsRevenue}"
                                                                ToolTip.Tip="{loc:Loc 'Create as revenue'}" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Category is shown read-only on the Product cell; it follows the selected product. -->

                                                <!-- Supplier / Customer column -->
                                                <Grid Grid.Column="5" Margin="8,0,0,0"
                                                      VerticalAlignment="Center">

                                                    <!-- Supplier dropdown (expense) -->
                                                    <controls:SearchableDropdown
                                                        IsVisible="{Binding !CreateAsRevenue}"
                                                        Classes="compact"
                                                        Placeholder="{loc:Loc 'Supplier...'}"
                                                        ItemsSource="{Binding $parent[ItemsControl].((vm:BankStatementImportModalViewModel)DataContext).AvailableSuppliers}"
                                                        SelectedItem="{Binding ResolvedSupplierObject, Mode=TwoWay}"
                                                        SearchText="{Binding CounterpartySearchText, Mode=TwoWay}"
                                                        DisplayMemberPath="Name"
                                                        ShowAddNew="True"
                                                        AddNewText="{loc:Loc 'Create one'}"
                                                        AddNewCommand="{Binding CreateNewCounterpartyCommand}"
                                                        HasError="{Binding HasCounterpartyError}"
                                                        ErrorMessage="{loc:Loc 'Please select or create a supplier.'}" />

                                                    <!-- Customer dropdown (revenue) -->
                                                    <controls:SearchableDropdown
                                                        IsVisible="{Binding CreateAsRevenue}"
                                                        Classes="compact"
                                                        Placeholder="{loc:Loc 'Customer...'}"
                                                        ItemsSource="{Binding $parent[ItemsControl].((vm:BankStatementImportModalViewModel)DataContext).AvailableCustomers}"
                                                        SelectedItem="{Binding ResolvedCustomerObject, Mode=TwoWay}"
                                                        SearchText="{Binding CounterpartySearchText, Mode=TwoWay}"
                                                        DisplayMemberPath="Name"
                                                        ShowAddNew="True"
                                                        AddNewText="{loc:Loc 'Create one'}"
                                                        AddNewCommand="{Binding CreateNewCounterpartyCommand}"
                                                        HasError="{Binding HasCounterpartyError}"
                                                        ErrorMessage="{loc:Loc 'Please select or create a customer.'}" />
                                                </Grid>

                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>

                        </Grid>
                        </ScrollViewer>
                    </Panel>

                    <!-- Footer -->
                    <Border Grid.Row="2" Padding="24,16"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{loc:Loc 'Please enter all required fields'}"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding HasValidationMessage}" />
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       IsVisible="{Binding !HasValidationMessage}"
                                       Text="{Binding IncludedCountText}" />
                            <TextBlock Grid.Column="1" Margin="16,0,0,0"
                                       Text="{Binding AiUnavailableMessage}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding AiUnavailable}" />
                            <Button Grid.Column="2" Margin="0,0,12,0"
                                    Content="{loc:Loc Cancel}"
                                    Classes="secondary-button"
                                    Command="{Binding CancelCommand}" />
                            <Button Grid.Column="3"
                                    Content="{loc:Loc Import}"
                                    Classes="primary-button"
                                    Command="{Binding ImportCommand}" />
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </controls:ModalOverlay.ModalContent>
    </controls:ModalOverlay>

</UserControl>
