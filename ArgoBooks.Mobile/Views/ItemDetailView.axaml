<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.Mobile.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             x:Class="ArgoBooks.Mobile.Views.ItemDetailView"
             x:DataType="vm:ItemDetailViewModel">

  <StackPanel Margin="16" Spacing="14">
    <Border Background="#14808080" CornerRadius="10" Padding="14">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Subtitle}" FontSize="13" Opacity="0.65" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Amount}" FontSize="20" FontWeight="Bold" Margin="0,8,0,0" />
      </StackPanel>
    </Border>
    <TextBlock Text="Read-only on mobile. Edit on your desktop."
               Opacity="0.55" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
