<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:ArgoBooks.Controls"
             xmlns:loc="using:ArgoBooks.Localization"
             xmlns:icons="using:ArgoBooks"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="40"
             x:Class="ArgoBooks.Controls.CategoryInput"
             x:DataType="controls:CategoryInput"
             x:Name="Root"
             Focusable="True">

    <Grid>
        <!-- No Categories Message -->
        <Border IsVisible="{Binding #Root.HasCategories, Converter={x:Static BoolConverters.Not}}"
                CornerRadius="6"
                BorderThickness="1"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                Padding="12,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{loc:Loc 'No categories.'}"
                           FontSize="13"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" />
                <Button Classes="link-button"
                        Content="{loc:Loc 'Create one'}"
                        Click="OnCreateCategoryClick"
                        VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Category Dropdown (shown when categories exist) -->
        <Border x:Name="CategoryDropdownBorder"
                IsVisible="{Binding #Root.HasCategories}"
                CornerRadius="6"
                BorderThickness="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                Classes.focused="{Binding #Root.IsDropdownOpen}">
            <Border.Styles>
                <Style Selector="Border.focused">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                </Style>
                <Style Selector="Border:pointerover:not(.focused)">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
                </Style>
            </Border.Styles>

            <Grid ColumnDefinitions="*,Auto">
                <!-- Search/Display TextBox -->
                <TextBox x:Name="CategorySearchBox"
                         Grid.Column="0"
                         Text="{Binding #Root.SearchText, Mode=TwoWay}"
                         PlaceholderText="{loc:Loc 'Search categories...'}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="12,10"
                         FontSize="14"
                         VerticalAlignment="Center"
                         MaxLength="100" />

                <!-- Dropdown Arrow -->
                <Button Grid.Column="1"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="24" Height="24"
                        Margin="0,0,8,0"
                        Padding="0"
                        CornerRadius="4"
                        Cursor="Hand"
                        Command="{Binding #Root.ToggleDropdownCommand}">
                    <PathIcon Data="{x:Static icons:Icons.ChevronDownSmall}"
                              Width="12" Height="12"
                              Foreground="{DynamicResource TextTertiaryBrush}" />
                </Button>
            </Grid>
        </Border>

        <!-- Category Dropdown Popup -->
        <Popup x:Name="CategoryDropdownPopup"
               IsOpen="{Binding #Root.IsDropdownOpen, Mode=TwoWay}"
               PlacementTarget="{Binding #CategoryDropdownBorder}"
               Placement="Bottom"
               PlacementGravity="BottomLeft"
               IsLightDismissEnabled="True"
               WindowManagerAddShadowHint="True">

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Width="280"
                    MaxHeight="300"
                    Margin="0,4,0,0"
                    BoxShadow="0 4 12 0 #20000000">

                <DockPanel>
                    <!-- Create New Category Button (bottom, always visible when command is set) -->
                    <Button DockPanel.Dock="Bottom"
                            Classes="ghost"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,10"
                            IsVisible="{Binding #Root.OpenCategoriesPageCommand, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Click="OnCreateCategoryClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{x:Static icons:Icons.Add}"
                                      Width="16" Height="16"
                                      Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Text="{loc:Loc 'Create new category'}"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       FontWeight="Medium" />
                        </StackPanel>
                    </Button>

                    <!-- Separator above Create button (visible when command is set) -->
                    <Border DockPanel.Dock="Bottom"
                            Height="1"
                            Background="{DynamicResource BorderLightBrush}"
                            IsVisible="{Binding #Root.OpenCategoriesPageCommand, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <!-- No Results Message -->
                    <TextBlock Text="{loc:Loc 'No categories found'}"
                               FontSize="13"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Padding="12,16"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding #Root.HasFilteredCategories, Converter={x:Static BoolConverters.Not}}" />

                    <!-- Filtered Items -->
                    <ListBox x:Name="CategoryListBox"
                             ItemsSource="{Binding #Root.FilteredCategories}"
                             SelectedIndex="{Binding #Root.SelectedIndex, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             IsVisible="{Binding #Root.HasFilteredCategories}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="controls:CategoryItem">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>

</UserControl>
