<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.Mobile.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="700"
             x:Class="ArgoBooks.Mobile.Views.CaptureView"
             x:DataType="vm:CaptureViewModel">

  <UserControl.Styles>
    <Style Selector="Border.company-chip">
      <Setter Property="Background" Value="#14808080" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border.viewfinder">
      <Setter Property="BorderBrush" Value="#2FB8A8" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="14" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">

    <Border Grid.Row="0" Classes="company-chip" Margin="0,0,0,10">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Grid.Column="0" Text="Scanning into" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding ActiveCompanyLabel}"
                   FontSize="12" FontWeight="SemiBold"
                   HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <TextBlock Grid.Row="1"
               Text="{Binding ScansUsedThisMonth, StringFormat='{}{0} scans used this month'}"
               FontSize="12" Opacity="0.6" Margin="2,0,0,10" />

    <Border Grid.Row="2" Classes="viewfinder">
      <TextBlock Text="Line up the receipt in frame, then tap Scan receipt"
                 Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28" />
    </Border>

    <Button Grid.Row="3"
            Content="Scan receipt"
            Command="{Binding ScanCommand}"
            IsEnabled="{Binding !IsBusy}"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
            Margin="0,14,0,0" />

    <Button Grid.Row="4"
            Content="Import from photos"
            Command="{Binding ScanCommand}"
            IsEnabled="{Binding !IsBusy}"
            Background="Transparent"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
            Margin="0,8,0,0" />

    <TextBlock Grid.Row="5"
               Text="Detects, crops &amp; straightens automatically."
               Opacity="0.5" FontSize="11" TextAlignment="Center"
               HorizontalAlignment="Center" Margin="0,10,0,0" />
  </Grid>
</UserControl>
