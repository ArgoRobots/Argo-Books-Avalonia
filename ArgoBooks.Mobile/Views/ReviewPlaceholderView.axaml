<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArgoBooks.Mobile.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="700"
             x:Class="ArgoBooks.Mobile.Views.ReviewPlaceholderView"
             x:DataType="vm:ReviewPlaceholderViewModel">

  <ScrollViewer Padding="20">
    <StackPanel Spacing="10">
      <TextBlock Text="Scan read successfully" FontSize="20" FontWeight="Bold" />
      <TextBlock Text="The full editable review (products, supplier, date, total) is coming soon. Here's what was read:"
                 Opacity="0.7" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10" />

      <Border Background="#14808080" CornerRadius="10" Padding="14">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding SupplierText}" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding DateText}" FontSize="13" Opacity="0.75" />
          <TextBlock Text="{Binding TotalText}" FontSize="18" FontWeight="Bold" Margin="0,6,0,0" />
          <TextBlock Text="{Binding LineItemCountText}" FontSize="13" Opacity="0.75" />
        </StackPanel>
      </Border>

      <Button Content="Done"
              Command="{Binding DoneCommand}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Margin="0,16,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
